{
if ($macro instanceof Closure) {
$boundMacro = @$macro->bindTo($this, static::class) ?: @$macro->bindTo(null, static::class);

return \call_user_func_array($boundMacro ?: $macro, $parameters);
}

return \call_user_func_array($macro, $parameters);
}

