for ($i = $indexStart; $i <= $indexEnd; ++$i) {
$token = $tokens[$i];

if ($token->isComment()) {
continue;
}

if ($token->isWhitespace("\n\r")) {
continue;
}

$tokens->clearAt($i);
}
}
