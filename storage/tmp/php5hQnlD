class Comparator
{
private string $operator;

public function __construct(
private string $target,
string $operator = '==',
) {
if (!\in_array($operator, ['>', '<', '>=', '<=', '==', '!='], true)) {
throw new \InvalidArgumentException(\sprintf('Invalid operator "%s".', $operator));
