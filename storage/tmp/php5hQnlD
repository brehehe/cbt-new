protected function applyFix(\SplFileInfo $file, Tokens $tokens): void
{
$functionKinds = [\T_FUNCTION, \T_FN];

for ($i = 0, $l = $tokens->count(); $i < $l; ++$i) {
if (!$tokens[$i]->isGivenKind($functionKinds)) {
