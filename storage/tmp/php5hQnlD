{
if ([] === $this->configuration['annotations']) {
return;
}

for ($index = $tokens->count() - 1; $index > 0; --$index) {
foreach ($this->configuration['annotations'] as $type => $typeLowerCase) {
$findPattern = \sprintf(
'/@%s\s.+@%s\s/s',
$type,
$type,
);

