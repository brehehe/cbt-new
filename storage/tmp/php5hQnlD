for ($i = $startIndex;; ++$i) {
$token = $tokens[$i];

if ($token->isGivenKind(FCT::T_ATTRIBUTE)) {
$i = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $i);

