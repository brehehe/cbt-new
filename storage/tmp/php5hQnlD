{
public function getDefinition(): FixerDefinitionInterface
{
return new FixerDefinition(
'Docblocks should have the same indentation as the documented subject.',
[
new CodeSample(
<<<'PHP'
                        <?php
                        class DocBlocks
                        {
                        /**
                         * Test constants
                         */
                            const INDENT = 1;
                        }

                        PHP,
),
],
);
