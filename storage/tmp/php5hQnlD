&& !$tokens[$index - 1]->isComment()
) {
$tokens[$index] = new Token([\T_WHITESPACE, ' ']);
}

return;
}

$index += $after ? 0 : 1;
$tokens->insertAt($index, new Token([\T_WHITESPACE, ' ']));
}
