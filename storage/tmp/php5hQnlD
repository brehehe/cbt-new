}

for ($index = $newLineTokenIndex + 1, $max = \count($tokens); $index < $max; ++$index) {
$token = $tokens[$index];

if (str_contains($token->getContent(), "\n")) {
return false;
}

return $tokens[$index]->isType(DocLexer::T_AT);
}

return false;
}
