while (true) {
$prev = $tokens->getPrevMeaningfulToken($classBeginIndex);
if (!$tokens[$prev]->isGivenKind([\T_NS_SEPARATOR, \T_STRING])) {
break;
}

$classBeginIndex = $prev;
