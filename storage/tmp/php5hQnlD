$startIndex = $tokens->getNextMeaningfulToken($startIndex);

$inserts[$startIndex] = [new Token([\T_YIELD, 'yield']), new Token([\T_WHITESPACE, ' '])];

foreach ($this->findArrayItemCommaIndex(
