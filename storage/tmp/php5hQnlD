{
foreach ($tokens->findGivenKind(\T_RETURN) as $index => $token) {
if (!$this->shouldBeFixed($tokens, $index)) {
continue;
}

$tokens[$index] = new Token([\T_YIELD_FROM, 'yield from']);
}
