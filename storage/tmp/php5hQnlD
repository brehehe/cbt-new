}

protected function applyFix(\SplFileInfo $file, Tokens $tokens): void
{
foreach ($this->findBraceOpen($tokens) as $index) {
if ($this->isOverComplete($tokens, $index)) {
$this->clearOverCompleteBraces($tokens, $index);
}
}

