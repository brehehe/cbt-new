$tokens->clearRange($firstArgStartIndex, $firstArgEndIndex);

$afterFirstArgIndex = $tokens->getNextMeaningfulToken($firstArgEndIndex);
$afterFirstArgToken = $tokens[$afterFirstArgIndex];

