if (

('php' !== $file->getExtension())

|| !Preg::match('/^'.TypeExpression::REGEX_IDENTIFIER.'$/', $file->getBasename('.php'))
) {
return false;
}

try {
$tokens = Tokens::fromCode(\sprintf('<?php class %s {}', $file->getBasename('.php')));

if ($tokens[3]->isKeyword() || $tokens[3]->isMagicConstant()) {

