$tokens->clearTokenAndMergeSurroundingWhitespace($prevStartIndex); 
}

$tokens->clearTokenAndMergeSurroundingWhitespace($startIndex);
$tokens->clearTokenAndMergeSurroundingWhitespace($endIndex);

