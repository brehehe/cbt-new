$workerResponse['class'],
$workerResponse['message'],
$workerResponse['file'],
$workerResponse['line'],
$workerResponse['code'],
$workerResponse['trace'],
));

throw WorkerException::fromRaw($workerResponse);
}

throw new ParallelisationException('Unsupported action: '.($workerResponse['action'] ?? 'n/a'));
