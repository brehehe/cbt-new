$set = $this->resolveSubset($name, $value);
$resolvedRules = array_merge($resolvedRules, $set);
} else {
$resolvedRules[$name] = $value;
}
}


$resolvedRules = array_filter(
$resolvedRules,
static fn ($value): bool => false !== $value,
);

