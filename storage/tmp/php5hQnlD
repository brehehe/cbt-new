{
$beforeIndex = $tokens->getPrevNonWhitespace($index);

if (!$tokens[$beforeIndex]->isGivenKind(\T_COMMENT)) {
return false;
}

$content = $tokens[$beforeIndex]->getContent();

return str_starts_with($content, '#') || str_starts_with($content, '//');
}
