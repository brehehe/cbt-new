if (null !== $stdErr) {
$warningsDetector = new WarningsDetector($this->toolInfo);
$warningsDetector->detectOldVendor();
$warningsDetector->detectOldMajor();

try {
$commandName = $this->getCommandName($input);
if (null === $commandName) {
