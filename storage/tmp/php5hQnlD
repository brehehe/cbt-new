'callable',
'object', 
'array', 
'mixed', 

], true);
}


if (class_exists($returnedTypeName)) {
return !is_a($returnedTypeName, Closure::class, true) && !\is_callable([$returnedTypeName, '__invoke']);
}
}

return false;
