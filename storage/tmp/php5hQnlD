throw new InvalidOptionsException(\sprintf(
'Unknown value "%s", expected any of %s.',
\is_object($to) ? \get_class($to) : \gettype($to).(\is_resource($to) ? '' : '#'.$to),
Utils::naturalLanguageJoin(self::TO_TYPES),
