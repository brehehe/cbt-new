$mainIndex = $index;
$index = $tokens->getNextMeaningfulToken($index);
$addReadonly = true;

while ($tokens[$index]->isGivenKind([
\T_ABSTRACT,
\T_FINAL,
\T_PRIVATE,
\T_PUBLIC,
\T_PROTECTED,
\T_READONLY,
])) {
